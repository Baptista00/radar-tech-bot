TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=@RadarTechOfertas
TELEGRAM_ADMIN_ID=

# Manter false durante a validacao. /resume nao altera esta opcao.
AUTO_PUBLISH=false
MIN_OFFER_SCORE=70
MAX_POSTS_PER_DAY=12
MIN_MINUTES_BETWEEN_POSTS=30
REPOST_AFTER_HOURS=72
REPOST_PRICE_DROP_PERCENT=10
# Nomes antigos REPUBLISH_AFTER_HOURS e SIGNIFICANT_PRICE_DROP_PERCENT continuam aceitos.

SEARCH_INTERVAL_MINUTES=30
# Fonte local enquanto Mercado Livre aguarda suporte e Shopee aguarda aprovação.
OFFER_SOURCE=fixture
ACTIVE_CATEGORIES=mouse,teclado,headset,ssd,ram,monitor,notebook,gpu,cpu,microfone,webcam,controle,power_bank,hub,carregador,setup,other
SEARCH_TERMS=mouse gamer,headset gamer,ssd nvme
# Depois: teclado mecânico,mousepad,monitor gamer,notebook,memória ram ddr4,memória ram ddr5,placa de vídeo,processador,microfone usb,webcam,controle xbox,power bank,hub usb,carregador usb c
SEARCH_TERMS_PER_CYCLE=3
SEARCH_LIMIT_PER_TERM=10
REQUEST_INTERVAL_SECONDS=2
MELI_REQUEST_DELAY_SECONDS=1.0
# Entrada direta de anuncios publicos. Nao equivale a descoberta global por termo.
MELI_ITEM_IDS=
NEGATIVE_KEYWORDS=adesivo,adesivos,reposição,somente caixa,não comprar,defeito,retirada de peças,pezinhos,skate,skates,conserto
HISTORY_DAYS=30
POST_TIMEZONE=America/Sao_Paulo
KNOWN_BRANDS=Logitech,HyperX,Kingston,Samsung,Crucial,Corsair,Razer,Redragon,Lenovo,Acer,Asus,Dell,LG,AMD,Intel,Nvidia

# OAuth oficial. Tokens novos ficam no cofre local ignorado, nao neste arquivo.
MELI_CLIENT_ID=seu_client_id
MELI_CLIENT_SECRET=seu_client_secret
MELI_REDIRECT_URI=https://seu-dominio.example/oauth/callback
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
