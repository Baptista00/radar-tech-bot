TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=@RadarTechOfertas
TELEGRAM_ADMIN_ID=

# Manter false durante a validacao. /resume nao altera esta opcao.
AUTO_PUBLISH=false
MIN_OFFER_SCORE=70
MAX_POSTS_PER_DAY=12
MIN_MINUTES_BETWEEN_POSTS=30
REPUBLISH_AFTER_HOURS=72
SIGNIFICANT_PRICE_DROP_PERCENT=10

SEARCH_INTERVAL_MINUTES=60
SEARCH_TERMS=mouse,teclado,headset,mousepad,monitor,notebook,SSD,memoria RAM,placa de video,processador,controle gamer,microfone,webcam,carregador,hub USB,power bank,acessorios para setup,gadgets tech
SEARCH_TERMS_PER_CYCLE=3
SEARCH_LIMIT_PER_TERM=20
REQUEST_INTERVAL_SECONDS=2
HISTORY_DAYS=30
POST_TIMEZONE=America/Sao_Paulo

# Opcional: acesso autorizado a API oficial; nao e o token do Telegram.
# Sem acesso, o painel funciona e a busca informa a pendencia.
MERCADO_LIVRE_ACCESS_TOKEN=
